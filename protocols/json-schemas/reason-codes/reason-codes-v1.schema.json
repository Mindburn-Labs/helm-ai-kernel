{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helm.mindburn.run/schemas/reason-codes/v1",
  "title": "HELM Reason Code Registry v1",
  "description": "Machine-readable registry of HELM governance reason codes",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "codes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReasonCodeEntry"
      }
    }
  },
  "required": ["version", "codes"],
  "$defs": {
    "ReasonCodeEntry": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "description": "SCREAMING_SNAKE_CASE reason code identifier"
        },
        "applies_to": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["DENY", "ESCALATE"]
          },
          "minItems": 1,
          "description": "Verdict types this code may accompany"
        },
        "domain": {
          "type": "string",
          "enum": [
            "policy",
            "pdp",
            "requirement",
            "budget",
            "temporal",
            "envelope",
            "isolation",
            "jurisdiction",
            "industry",
            "custom",
            "agent_lifecycle",
            "approval",
            "capability",
            "company_activation",
            "compute",
            "connector",
            "connector.ton.acton",
            "delegation",
            "environment",
            "gui-action",
            "harness",
            "host_evidence",
            "identity",
            "network",
            "operations",
            "privilege",
            "safe-deprecation",
            "threat"
          ],
          "description": "Functional domain of this reason code"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description"
        },
        "jurisdiction": {
          "type": "string",
          "description": "Jurisdiction this code is specific to (for extension codes)"
        },
        "industry": {
          "type": "string",
          "description": "Industry this code is specific to (for extension codes)"
        },
        "since": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Registry version that introduced this code"
        },
        "finality": {
          "type": "string",
          "enum": ["class_forbidden", "ungranted", "instance_parameter", "instance_context", "instance_membership"],
          "description": "What kind of refusal this code represents, when the lesson is unambiguous. Absent means unclassified: a denial on this code teaches a consumer nothing. Vocabulary shared with DenialFinality in policy-schema/v1/verdict.proto and the workstation receipt schema."
        },
        "disclosure": {
          "type": "string",
          "enum": ["none", "scalar_bound", "capability_name"],
          "description": "What a counterfactual on this code may reveal. Absent means not yet considered; an explicit none means considered and deliberately discloses nothing. scalar_bound pairs only with finality instance_parameter, capability_name only with ungranted."
        }
      },
      "required": ["code", "applies_to", "domain", "description", "since"]
    },
    "Verdict": {
      "type": "string",
      "enum": ["ALLOW", "DENY", "ESCALATE"],
      "description": "Canonical HELM verdict types"
    }
  }
}
