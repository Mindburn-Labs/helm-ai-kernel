  "gates": [
    {
      "id": "quality-self-test",
      "title": "Quality registry self-test",
      "description": "Validates profile and gate registration before running long checks.",
      "command": "python3 scripts/ci/quality.py self-test",
      "timeout_seconds": 60
    },
    {
      "id": "docs-truth",
      "title": "Documentation coverage and truth",
      "description": "Ensures docs coverage rows and truth assertions remain aligned with live repo surfaces.",
      "command": "make docs-coverage docs-truth",
      "timeout_seconds": 600,
      "paths": [
        "docs/**",
        "README.md",
        "scripts/check_documentation_*.py",
        ".github/**",
        "Makefile"
      ]
    },
    {
      "id": "version-drift",
      "title": "Release version lockstep",
      "description": "Ensures VERSION, chart metadata, SDK manifests, OpenAPI metadata, generated SDK headers, and release docs agree.",
      "command": "make version-drift",
      "timeout_seconds": 120,
      "paths": [
        "VERSION",
        "Makefile",
        "release/version-surfaces.yaml",
        "scripts/release/check_version_drift.py",
        "scripts/release/prepare_version.py",
        ".github/workflows/release.yml",
        ".github/workflows/version-drift.yml",
        "deploy/helm-chart/Chart.yaml",
        "api/openapi/helm.openapi.yaml",
        "sdk/**",
        "docs/PUBLISHING.md",
        "docs/VERIFICATION.md",
        "docs/RELEASE_SECURITY.md",
        "README.md"
      ]
    },
    {
      "id": "console-sidecar-pin",
      "title": "Console sidecar source pin exists for the checked-in version",
      "description": "Requires exactly one Console source pin row for the version in VERSION. The release job reads release/console-local-sidecar-pins.json from the tag commit, so a row missing at tag time strands the tag permanently; this catches it while it is still one line in a PR.",
      "command": "python3 scripts/release/console_local_sidecar.py pin --pins release/console-local-sidecar-pins.json --kernel-release \"v$(cat VERSION)\"",
      "timeout_seconds": 30,
      "paths": [
        "VERSION",
        "release/console-local-sidecar-pins.json",
        "scripts/release/console_local_sidecar.py"
      ]
    },
    {
      "id": "release-workflow-contract",
      "title": "Release workflow provenance contract",
      "command": "python3 scripts/ci/release_workflow_contract_test.py",
      "timeout_seconds": 60,
      "paths": [
        ".github/workflows/**",
        "scripts/ci/quality-gates.json",
        "scripts/ci/release_workflow_contract_test.py"
      ]
    },
    {
      "id": "scorecard-workflow-contract",
      "title": "Scorecard least-privilege contract",
      "command": "python3 scripts/ci/scorecard_workflow_contract_test.py",
      "timeout_seconds": 60,
      "paths": [
        ".github/workflows/scorecard.yml",
        ".github/workflows/README.md",
        ".bestpractices.json",
        "BEST_PRACTICES.md",
        "scripts/ci/quality-gates.json",
        "scripts/ci/scorecard_workflow_contract_test.py"
      ]
    },
    {
      "id": "presentation-hygiene",
      "title": "Presentation hygiene",
      "command": "make verify-presentation",
      "timeout_seconds": 180,
      "paths": [
        "docs/**",
        "README.md",
        "tools/verify-presentation.sh"
      ]
    },
    {
      "id": "tracked-file-hygiene",
      "title": "Tracked file hygiene",
      "description": "Runs the canonical fail-closed tracked-artifact hygiene check.",
      "command": "make verify-presentation",
      "timeout_seconds": 60
    },
    {
      "id": "go-lint",
      "title": "Go lint and formatting",
      "command": "make lint",
      "timeout_seconds": 900,
      "paths": [
        "core/**",
        "tests/conformance/**",
        "examples/otel-genai/**",
        ".golangci.yml",
        "Makefile"
      ]
    },
    {
      "id": "build",
      "title": "Core CLI build",
      "command": "make build",
      "timeout_seconds": 900,
      "paths": [
        "core/**",
        "Makefile",
        "VERSION"
      ]
    },
    {
      "id": "go-test",
      "title": "Core Go tests",
      "command": "make test",
      "timeout_seconds": 1200,
      "paths": [
        "core/**",
        "Makefile"
      ]
    },
    {
      "id": "go-race",
      "title": "Core Go race tests",
      "command": "make test-race",
      "timeout_seconds": 1800,
      "paths": [
        "core/**",
        "Makefile"
      ]
    },
    {
      "id": "command-tests",
      "title": "CLI command tests",
      "command": "cd core && go test ./cmd/helm-ai-kernel -count=1",
      "timeout_seconds": 900,
      "paths": [
        "core/cmd/**",
        "core/pkg/**"
      ]
    },
    {
      "id": "verify-fixtures",
      "title": "Golden fixture verification",
      "command": "make verify-fixtures",
      "timeout_seconds": 300,
      "paths": [
        "core/pkg/verifier/**",
        "artifacts/golden/**",
        "fixtures/**",
        "Makefile"
      ]
    },
    {
      "id": "tcb-imports",
      "title": "TCB import isolation",
      "command": "go run tools/tcbcheck/main.go",
      "timeout_seconds": 300,
      "paths": [
        "core/pkg/**",
        "tools/tcbcheck/**"
      ]
    },
    {
      "id": "boundary-manifest",
      "title": "Boundary manifest drift",
      "command": "make verify-boundary",
      "timeout_seconds": 300,
      "paths": [
        "core/pkg/kernel/**",
        "core/pkg/contracts/**",
        "core/pkg/crypto/**",
        "core/pkg/evidencepack/**",
        "core/pkg/proofgraph/**",
        "core/pkg/receipts/**",
        "core/pkg/verifier/**",
        "core/pkg/connectors/sandbox/**",
        "core/pkg/conformance/**",
        "core/pkg/api/**",
        "core/pkg/guardian/**",
        "protocols/**",
        "schemas/**",
        "tools/boundary/**"
      ]
    },
    {
      "id": "quantum-crypto-inventory",
      "title": "Quantum crypto posture annotations",
      "description": "quantum_posture: CI guard registration only; not a cryptographic control.",
      "command": "make quantum-crypto-inventory",
      "timeout_seconds": 120,
      "paths": [
        ".github/**",
        "Makefile",
        "core/**",
        "deploy/**",
        "protocols/**",
        "scripts/**",
        "sdk/**"
      ]
    },
    {
      "id": "crucible",
      "title": "Use-case crucible",
      "command": "make crucible",
      "timeout_seconds": 1200,
      "paths": [
        "core/**",
        "scripts/usecases/**",
        "artifacts/golden/**"
      ]
    },
    {
      "id": "go-sdk",
      "title": "Standalone Go SDK tests",
      "command": "make test-sdk-go-standalone",
      "timeout_seconds": 900,
      "paths": [
        "sdk/go/**",
        "protocols/proto/**"
      ]
    },
    {
      "id": "python-sdk",
      "title": "Python SDK tests",
      "command": "make test-sdk-py",
      "timeout_seconds": 900,
      "paths": [
        "sdk/python/**",
        "api/openapi/**",
        "protocols/proto/**"
      ]
    },
    {
      "id": "ts-sdk",
      "title": "TypeScript SDK tests",
      "command": "make test-sdk-ts",
      "timeout_seconds": 900,
      "paths": [
        "sdk/ts/**",
        "api/openapi/**",
        "protocols/proto/**"
      ]
    },
    {
      "id": "rust-sdk",
      "title": "Rust SDK tests",
      "command": "make test-sdk-rust",
      "timeout_seconds": 900,
      "paths": [
        "sdk/rust/**",
        "protocols/proto/**"
      ]
    },
    {
      "id": "java-sdk",
      "title": "Java SDK tests",
      "command": "make test-sdk-java",
      "timeout_seconds": 900,
      "paths": [
        "sdk/java/**",
        "protocols/proto/**"
      ]
    },
    {
      "id": "ts-sdk-typecheck",
      "title": "TypeScript SDK typecheck",
      "command": "cd sdk/ts && npm ci && npm run build",
      "timeout_seconds": 600,
      "paths": [
        "sdk/ts/**",
        "protocols/proto/**"
      ]
    },
    {
      "id": "json-schemas",
      "title": "JSON schema compilation and registry conformance",
      "command": "python3 scripts/ci/check_json_schemas_test.py && python3 scripts/ci/check_json_schemas.py && python3 scripts/ci/check_reason_codes.py",
      "timeout_seconds": 300,
      "paths": [
        "schemas/**",
        "protocols/json-schemas/**",
        "protocols/specs/**",
        "api/openapi/**",
        ".github/schema-requirements.txt",
        "scripts/ci/check_json_schemas.py",
        "scripts/ci/check_json_schemas_test.py",
        "scripts/ci/check_reason_codes.py"
      ]
    },
    {
      "id": "sdk-openapi-check",
      "title": "OpenAPI SDK contract drift",
      "command": "make sdk-openapi-check",
      "timeout_seconds": 1200,
      "paths": [
        "api/openapi/**",
        "sdk/**",
        "scripts/sdk/**",
        "Makefile"
      ]
    },
    {
      "id": "codegen-drift",
      "title": "Generated contract drift",
      "command": "make codegen-check",
      "timeout_seconds": 1200,
      "paths": [
        "protocols/proto/**",
        "sdk/go/gen/**",
        "sdk/python/helm_sdk/generated/**",
        "sdk/ts/src/generated/**",
        "sdk/java/src/main/java/helm/**",
        "sdk/rust/src/generated/**",
        "Makefile"
      ]
    },
    {
      "id": "proto-lint",
      "title": "Protocol lint",
      "command": "make proto-lint",
      "timeout_seconds": 300,
      "paths": [
        "protocols/policy-schema/**",
        "protocols/proto/**",
        "scripts/ci/check_proto_lint_exemptions.sh",
        "buf.yaml",
        "Makefile"
      ]
    },
    {
      "id": "contract-breaking-self-test",
      "title": "Contract-breaking gate regression test",
      "description": "Proves unavailable bases and differ execution failures fail closed, while mutable label-style input cannot override a break.",
      "command": "make test-contract-breaking",
      "timeout_seconds": 120,
      "paths": [
        ".github/workflows/ci.yml",
        ".github/workflows/release.yml",
        "scripts/ci/contract_breaking.sh",
        "scripts/ci/test_contract_breaking.sh",
        "scripts/ci/quality-gates.json",
        "scripts/ci/quality.py",
        "Makefile"
      ]
    },
    {
      "id": "contract-breaking-release",
      "title": "Prior-release contract-breaking check",
      "description": "Diffs OpenAPI and both buf modules (protocols/policy-schema, protocols/proto) against the commit resolved from the immutable prior release tag.",
      "command": "make contract-breaking-release",
      "timeout_seconds": 600,
      "paths": [
        ".github/workflows/release.yml",
        "api/openapi/**",
        "protocols/specs/effects/openapi.yaml",
        "protocols/policy-schema/**",
        "protocols/proto/**",
        "VERSION",
        "scripts/ci/contract_breaking.sh",
        "Makefile"
      ]
    },
    {
      "id": "proto-breaking",
      "title": "Protocol breaking-change check",
      "command": "make proto-breaking",
      "timeout_seconds": 600,
      "paths": [
        "protocols/policy-schema/**",
        "protocols/proto/**",
        "VERSION",
        "scripts/ci/contract_breaking.sh",
        "Makefile"
      ]
    },
    {
      "id": "proto-gates-self-test",
      "title": "Protocol gate positive controls",
      "description": "Runs real buf with the protocols/proto buf.yaml against known-bad fixtures (misnamed RPCs, misplaced package, deleted field, deleted file) and the release-baseline gate against a tagged fixture repository; each must fail.",
      "command": "make test-proto-gates",
      "timeout_seconds": 600,
      "paths": [
        "protocols/proto/**",
        "protocols/policy-schema/**",
        "scripts/ci/contract_breaking.sh",
        "scripts/ci/check_proto_lint_exemptions.sh",
        "scripts/ci/test_proto_gates.sh",
        "Makefile"
      ]
    },
    {
      "id": "openapi-breaking",
      "title": "OpenAPI breaking-change check",
      "command": "make openapi-breaking",
      "timeout_seconds": 600,
      "paths": [
        "api/openapi/**",
        "protocols/specs/effects/openapi.yaml",
        "scripts/ci/contract_breaking.sh",
        "Makefile"
      ]
    },
    {
      "id": "deployment-smoke",
      "title": "Docker, Compose, and chart smoke",
      "command": "make deployment-smoke",
      "timeout_seconds": 2400,
      "paths": [
        "Dockerfile*",
        "docker-compose.yml",
        "deploy/**",
        "core/**",
        "scripts/ci/*smoke*.sh"
      ]
    },
    {
      "id": "helm-smoke-hardening",
      "title": "Containerized Helm smoke fallback hardening",
      "command": "python3 scripts/ci/check_helm_smoke_hardening.py",
      "timeout_seconds": 120,
      "paths": [
        "deploy/helm-chart/templates/deployment.yaml",
        "deploy/helm-chart/values.yaml",
        "deploy/helm-chart/values.schema.json",
        "scripts/ci/kind_smoke.sh",
        "scripts/ci/helm_chart_smoke.sh",
        "scripts/ci/launchpad_k8s_smoke.sh",
        "scripts/ci/check_helm_smoke_hardening.py",
        "scripts/ci/quality-gates.json"
      ]
    },
    {
      "id": "docker-smoke-hardening",
      "title": "Docker smoke local exposure hardening",
      "command": "python3 scripts/ci/check_docker_smoke_hardening.py",
      "timeout_seconds": 120,
      "paths": [
        "scripts/ci/docker_smoke.sh",
        "scripts/ci/check_docker_smoke_hardening.py",
        "docker-compose.yml",
        "scripts/ci/quality-gates.json"
      ]
    },
    {
      "id": "tla-tools-hardening",
      "title": "TLA tools download integrity hardening",
      "command": "python3 scripts/ci/check_tla_tools_hardening.py",
      "timeout_seconds": 120,
      "paths": [
        "scripts/tla/download-tools.sh",
        ".github/workflows/tla.yml",
        "scripts/ci/check_tla_tools_hardening.py",
        "scripts/ci/quality-gates.json"
      ]
    },
    {
      "id": "release-smoke",
      "title": "Release reproducibility and evidence smoke",
      "command": "make release-smoke",
      "timeout_seconds": 2400,
      "paths": [
        "Makefile",
        "scripts/ci/release_smoke.sh",
        "scripts/release/**",
        "release/**",
        "core/**",
        "install.sh",
        "docs/PUBLISHING.md",
        "docs/launchpad/HERMES_PRODUCTION_RUNBOOK.md"
      ]
    },
    {
      "id": "release-readiness",
      "title": "Release readiness aggregate",
      "command": "make release-readiness",
      "timeout_seconds": 3600
    },
    {
      "id": "reproducible-binaries",
      "title": "Reproducible release binaries",
      "command": "make release-binaries-reproducible",
      "timeout_seconds": 1800,
      "paths": [
        "core/**",
        "Makefile",
        "VERSION"
      ]
    },
    {
      "id": "sbom",
      "title": "CycloneDX SBOM generation",
      "command": "make sbom",
      "timeout_seconds": 900,
      "paths": [
        "core/go.mod",
        "core/go.sum",
        "scripts/ci/generate_sbom.sh",
        "Makefile"
      ]
    },
    {
      "id": "vex",
      "title": "OpenVEX generation",
      "command": "make vex",
      "timeout_seconds": 300,
      "paths": [
        "release/vex/**",
        "scripts/release/generate_vex.sh",
        "sbom.json",
        "Makefile"
      ]
    },
    {
      "id": "cosign-verify",
      "title": "Cosign bundle verification",
      "command": "bash -lc 'if find dist -name \"*.cosign.bundle\" -type f 2>/dev/null | grep -q .; then make verify-cosign; else echo \"No Cosign bundles under dist; skipping local verification.\"; fi'",
      "timeout_seconds": 300
    },
    {
      "id": "secrets",
      "title": "Secret scan (gitleaks)",
      "description": "gitleaks over the tracked tree with .gitleaks.toml. A planted-key positive control runs first; findings not in scripts/ci/gitleaks-allowlist.txt, and allowlisted findings that no longer occur, fail.",
      "command": "bash scripts/ci/security_gates.sh gitleaks",
      "timeout_seconds": 300
    },
    {
      "id": "vuln-audit",
      "title": "Dependency vulnerability audits",
      "description": "npm audit of sdk/ts. Go (govulncheck), Python (pip-audit) and Rust (the Rust audit job in codeql.yml) are audited by blocking gates.",
      "command": "bash scripts/ci/vuln_audit.sh",
      "timeout_seconds": 1800,
      "advisory": true,
      "paths": [
        "core/go.mod",
        "core/go.sum",
        "sdk/**"
      ]
    },
    {
      "id": "gosec",
      "title": "gosec (golangci-lint)",
      "description": "gosec over core and sdk/go. A fixture positive control runs first; findings not in scripts/ci/gosec-allowlist.txt, and allowlisted findings that no longer occur, fail.",
      "command": "bash scripts/ci/security_gates.sh gosec",
      "timeout_seconds": 2400
    },
    {
      "id": "govulncheck",
      "title": "govulncheck in every Go module",
      "description": "Fails on any vulnerability whose vulnerable symbol is reachable, in any tracked go.mod. A fixture that calls a known-vulnerable x/text symbol must be flagged first.",
      "command": "bash scripts/ci/security_gates.sh govulncheck",
      "timeout_seconds": 2400
    },
    {
      "id": "pip-audit",
      "title": "pip-audit of the Python SDK runtime requirements",
      "description": "Audits the hash-pinned sdk/python/requirements-runtime.txt. A known-vulnerable pin must be flagged first.",
