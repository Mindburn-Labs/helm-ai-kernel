      },
      "expect": {
        "attempt": {
          "state": "ESCALATED",
          "reason_code": "APPROVAL_REQUIRED",
          "risk_class": "HIGH",
          "pending_approval": true
        }
      }
    },
    {
      "note": "No proof: the approval fails closed.",
      "rpc": "Approve",
      "token": "approve-merge",
      "request": {
        "attempt_id": "{{attempt_id:merge}}",
        "approval_digest": "{{approval_digest:merge}}",
        "reason": "ok"
      },
      "expect": {
        "error": {
          "code": "permission_denied",
          "reason_code": "STEP_UP_REQUIRED"
        }
      }
    },
    {
      "note": "A decide token is not a proof: only the scope helm.gateway.stepup is.",
      "rpc": "Approve",
      "token": "approve-merge",
      "step_up_token": "proof-merge-decide-scope",
      "request": {
        "attempt_id": "{{attempt_id:merge}}",
        "approval_digest": "{{approval_digest:merge}}",
        "reason": "ok"
