{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helm.mindburn.org/schemas/provider-recovery-checkpoint.v1",
  "title": "Provider recovery checkpoint capture evidence v1",
  "description": "Closed evidence descriptor only; no persistence, restore, resume or installer authority. Go validation additionally enforces ordered sets and cross-field bindings.",
  "$ref": "#/$defs/descriptor",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "workspace_id",
        "organization_id",
        "operation_id",
        "installation_id",
        "generation"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "organization_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "installation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "subject",
        "source_revision",
        "image_digest",
        "pod_uid",
        "service_account_uid",
        "cohort_digest"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "pattern": "^https://[^/?#@\\s]+$",
          "maxLength": 512
        },
        "subject": {
          "const": "spiffe://helm/control-plane"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pod_uid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "service_account_uid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "cohort_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cp_version_id",
        "authority_version_id",
        "covered_version_ids",
        "plan_digest",
        "cutoff_watermark",
        "authority_revision",
        "inventory_count",
        "unresolved_count",
        "before_inventory_watermark",
        "after_inventory_watermark"
      ],
      "properties": {
        "cp_version_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "authority_version_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "covered_version_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "cutoff_watermark": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "authority_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "inventory_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unresolved_count": {
          "const": 0
        },
        "before_inventory_watermark": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "after_inventory_watermark": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "byte_length",
        "custody_id",
        "schema_digest",
        "capture_catalog_digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "custody_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "schema_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "capture_catalog_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "row_count",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "realtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "head",
        "floor"
      ],
      "properties": {
        "stream_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "head": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "floor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_row_version",
        "spec_digest",
        "work_revision_digest",
        "run_event_heads_digest",
        "episode_heads_digest",
        "lease_identity_digest",
        "queue_intent_digest",
        "sections",
        "realtime_context"
      ],
      "properties": {
        "organization_row_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "spec_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "work_revision_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "run_event_heads_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "episode_heads_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "lease_identity_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "queue_intent_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "realtime_context": {
          "$ref": "#/$defs/realtime"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source_repository",
        "source_revision",
        "image_digest",
        "platform",
        "namespace_uid",
        "workload_uid",
        "service_uid",
        "service_account_uid",
        "pod_uids",
        "trust_role",
        "observation_digest"
      ],
      "properties": {
        "name": {
          "enum": [
            "certification",
            "control_plane",
            "data_plane",
            "evidence_signer",
            "kernel",
            "sandbox_runner",
            "workload_identity",
            "console"
          ]
        },
        "source_repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "platform": {
          "enum": [
            "linux/amd64",
            "linux/arm64"
          ]
        },
        "namespace_uid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "workload_uid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "service_uid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "service_account_uid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "pod_uids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "not": {
              "const": "00000000-0000-0000-0000-000000000000"
            }
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "trust_role": {
          "enum": [
            "none",
            "authority",
            "signer"
          ]
        },
        "observation_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "installed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_digest",
        "cluster_ca_digest",
        "public_trust_digest",
        "before_observation_digest",
        "after_observation_digest",
        "runtime_components",
        "console"
      ],
      "properties": {
        "cohort_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "cluster_ca_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "public_trust_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "before_observation_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "after_observation_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "runtime_components": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/component"
                },
                {
                  "properties": {
                    "name": {
                      "const": "certification"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/component"
                },
                {
                  "properties": {
                    "name": {
                      "const": "control_plane"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/component"
                },
                {
                  "properties": {
                    "name": {
                      "const": "data_plane"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/component"
                },
                {
                  "properties": {
                    "name": {
                      "const": "evidence_signer"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/component"
                },
                {
                  "properties": {
                    "name": {
                      "const": "kernel"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/component"
                },
                {
                  "properties": {
                    "name": {
                      "const": "sandbox_runner"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/component"
                },
                {
                  "properties": {
                    "name": {
                      "const": "workload_identity"
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        },
        "console": {
          "allOf": [
            {
              "$ref": "#/$defs/component"
            },
            {
              "properties": {
                "name": {
                  "const": "console"
                }
              }
            }
          ]
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_id",
        "kind",
        "before_watermark",
        "after_watermark",
        "entry_count",
        "content_digest"
      ],
      "properties": {
        "store_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "enum": [
            "control_plane",
            "native_authority",
            "verified_content_copy"
          ]
        },
        "before_watermark": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "after_watermark": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "evidence_prefix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "envelope_digest"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "envelope_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "purpose",
        "scope",
        "producer",
        "native",
        "snapshot",
        "capture",
        "installed",
        "participants",
        "evidence_prefix"
      ],
      "properties": {
        "schema_version": {
          "const": "helm.provider-recovery-checkpoint.v1"
        },
        "purpose": {
          "const": "provider-recovery-checkpoint"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "native": {
          "$ref": "#/$defs/native"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "capture": {
          "$ref": "#/$defs/capture"
        },
        "installed": {
          "$ref": "#/$defs/installed"
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/participant"
          },
          "minItems": 3,
          "maxItems": 64,
          "uniqueItems": true
        },
        "evidence_prefix": {
          "$ref": "#/$defs/evidence_prefix"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyid",
        "sig"
      ],
      "properties": {
        "keyid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sig": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payloadType",
        "payload",
        "signatures"
      ],
      "properties": {
        "payloadType": {
          "const": "application/vnd.helm.provider-recovery-checkpoint.v1+json"
        },
        "payload": {
          "type": "string",
          "minLength": 4,
          "maxLength": 349528,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "signatures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signature"
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
