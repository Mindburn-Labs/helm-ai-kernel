{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindburn.org/schemas/spend/usage_receipt.v2.schema.json",
  "title": "usage_receipt v2",
  "description": "Exact provider tariff accrual; not a verified invoice or customer charge. Producer validation additionally enforces int64 bounds and conservation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "tenant_id",
    "workspace_id",
    "route_quote_id",
    "reserved_nano_cents",
    "accrued_nano_cents",
    "currency",
    "cost_basis",
    "evidence_pack_ref",
    "created_at",
    "content_hash",
    "spend_intent_id",
    "envelope_id",
    "agent_id",
    "provider_id",
    "model_id",
    "provider_request_id",
    "provider_price_snapshot_hash",
    "observation_digest",
    "input_tokens",
    "output_tokens",
    "policy_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "helm.usage-receipt.v2"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "route_quote_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "reserved_nano_cents": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 19
    },
    "accrued_nano_cents": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 19
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "cost_basis": {
      "const": "TARIFF_ESTIMATE"
    },
    "evidence_pack_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "spend_intent_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "envelope_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "provider_request_id": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "provider_price_snapshot_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "observation_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "input_tokens": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 19
    },
    "output_tokens": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 19
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
