{
  "schema": "helm.gateway.conformance.scenario.v1",
  "id": "GW-001",
  "title": "The HELM-789 walking skeleton: read, branch, draft pull request approved by a distinct human",
  "rule": {
    "statement": "A human proposes through the Control Plane runner: the repository read and the helm/ branch are admitted and dispatched by the runner; the draft pull request over the observed branch is a medium effect the mandate escalates, which a distinct human approves without step-up; each is observed SUCCEEDED, and a repeated Observe changes nothing.",
    "cites": [
      {
        "doc": "docs/architecture/gateway-effect-api.md",
        "section": "Typed observation results and the GitHub effects (HELM-753)"
      },
      {
        "doc": "docs/architecture/gateway-effect-api.md",
        "section": "Dispatch and Observe (slice 3)"
      },
      {
        "doc": "docs/architecture/gateway-effect-api.md",
        "section": "The delegated requester (s1b)"
      },
      {
        "doc": "protocols/proto/helm/gateway/v1/gateway.proto",
        "section": "rpc Dispatch("
      }
    ]
  },
  "fixtures": {
    "tenants": [
      "tenant-a",
      "tenant-b"
    ],
    "principals": [
      {
        "id": "human-a",
        "kind": "human"
      },
      {
        "id": "human-b",
        "kind": "human"
      },
      {
        "id": "human-c",
        "kind": "human"
      },
      {
        "id": "agent-a",
        "kind": "agent"
      },
      {
        "id": "cp-runner",
        "kind": "service"
      }
    ],
    "configured_actor": "cp-runner",
    "effect_types": [
      {
        "effect_type": "github.repository.get",
        "risk": "low"
      },
      {
        "effect_type": "github.branch.create_from_changes",
        "risk": "medium"
      },
      {
        "effect_type": "github.pull_request.create_draft",
        "risk": "medium"
      }
    ],
    "mandates": [
      {
        "holder": "human-a",
        "effect_types": [
          "github.repository.get",
          "github.branch.create_from_changes",
          "github.pull_request.create_draft"
        ],
        "targets": [
          "github.com/Mindburn-Labs/example"
        ],
        "condition": "input.effect_type == \"github.repository.get\" || input.args.head.startsWith(\"helm/\")",
        "approval_required": [
          "github.pull_request.create_draft"
        ],
        "activation": {
          "requester": "agent-a",
          "approver": "human-c"
        }
      }
    ],
    "adapter": {
      "effect_types": [
        "github.repository.get",
        "github.branch.create_from_changes",
        "github.pull_request.create_draft"
      ],
      "dispatch": {
        "status": "SENT"
      },
      "observe": {
        "status": "SUCCEEDED"
      },
      "provider": {
        "default_branch": "main",
        "default_branch_sha": "0123456789abcdef0123456789abcdef01234567",
        "branch_commit_sha": "89abcdef0123456789abcdef0123456789abcdef"
      }
    }
  },
  "tokens": {
    "propose-a": {
      "scope": "helm.gateway.propose",
      "sub": "human-a",
      "act_sub": "cp-runner",
      "tenant": "tenant-a",
      "workspace": "ws-a",
      "jti": "propose-a"
    },
    "execute-runner": {
      "scope": "helm.gateway.execute",
      "sub": "cp-runner",
      "tenant": "tenant-a",
      "workspace": "ws-a",
      "jti": "execute-runner"
    },
    "read-a": {
      "scope": "helm.gateway.read",
      "sub": "human-a",
      "tenant": "tenant-a",
      "workspace": "ws-a",
      "jti": "read-a"
    },
    "approve-b": {
      "scope": "helm.gateway.decide",
      "sub": "human-b",
      "act_sub": "cp-runner",
      "tenant": "tenant-a",
      "workspace": "ws-a",
      "jti": "decide-b",
      "authorization_details": [
        {
          "type": "helm_effect_decision",
          "attempt_id": "{{attempt_id:pr}}",
          "action": "approve"
        }
      ]
    }
  },
  "steps": [
    {
      "label": "repo",
      "rpc": "Propose",
      "token": "propose-a",
      "request": {
        "idempotency_key": "repo-1",
        "commitment_id": "commitment-1",
        "effect": {
          "effect_type": "github.repository.get",
          "target": "github.com/Mindburn-Labs/example",
          "arguments_json": {
            "schema": "helm.github.repository.get.v1"
          }
        }
      },
      "expect": {
        "attempt": {
          "state": "ADMITTED",
          "reason_code": "",
          "risk_class": "LOW",
          "requester_principal_id": "human-a",
          "requester_actor_id": "cp-runner",
          "permit": "ISSUED"
        },
        "existing": false
      }
    },
    {
      "rpc": "Dispatch",
      "token": "execute-runner",
      "request": {
        "attempt_id": "{{attempt_id:repo}}"
      },
      "expect": {
        "attempt": {
          "state": "OBSERVED",
          "reason_code": "",
          "outcome": "SUCCEEDED",
          "outcome_basis": "OBSERVED",
          "permit": "CONSUMED"
        },
        "existing": false
      }
    },
    {
      "label": "branch",
      "rpc": "Propose",
      "token": "propose-a",
      "request": {
        "idempotency_key": "branch-1",
        "commitment_id": "commitment-1",
        "effect": {
          "effect_type": "github.branch.create_from_changes",
          "target": "github.com/Mindburn-Labs/example",
          "arguments_json": {
            "schema": "helm.github.branch.create_from_changes.v1",
            "base": "main",
            "base_sha": "0123456789abcdef0123456789abcdef01234567",
            "head": "helm/skeleton",
            "message": "Add skeleton",
            "files": [
              {
                "path": "docs/skeleton.md",
                "mode": "100644",
                "content_utf8": "# Skeleton\n"
              }
            ]
          }
        }
      },
      "expect": {
        "attempt": {
          "state": "ADMITTED",
          "reason_code": "",
          "risk_class": "MEDIUM",
          "permit": "ISSUED"
        }
      }
    },
    {
      "rpc": "Dispatch",
      "token": "execute-runner",
      "request": {
        "attempt_id": "{{attempt_id:branch}}"
      },
      "expect": {
        "attempt": {
          "state": "OBSERVED",
          "reason_code": "",
          "outcome": "SUCCEEDED",
          "outcome_basis": "OBSERVED"
        }
      }
    },
    {
      "note": "An observed attempt is returned unchanged, with no provider I/O.",
      "rpc": "Observe",
      "token": "execute-runner",
      "request": {
        "attempt_id": "{{attempt_id:branch}}"
      },
      "expect": {
        "attempt": {
          "state": "OBSERVED",
          "reason_code": "",
          "outcome": "SUCCEEDED"
        },
        "existing": true,
        "adapter_calls": {
          "dispatch": 2,
          "observe": 2
        }
      }
    },
    {
      "label": "pr",
      "rpc": "Propose",
      "token": "propose-a",
      "request": {
        "idempotency_key": "pr-1",
        "commitment_id": "commitment-1",
        "effect": {
          "effect_type": "github.pull_request.create_draft",
          "target": "github.com/Mindburn-Labs/example",
          "arguments_json": {
            "schema": "helm.github.pull_request.create_draft.v1",
            "branch_attempt_id": "{{attempt_id:branch}}",
            "base": "main",
            "head": "helm/skeleton",
            "head_sha": "89abcdef0123456789abcdef0123456789abcdef",
            "title": "Skeleton",
            "body": ""
          }
        }
      },
      "expect": {
        "attempt": {
          "state": "ESCALATED",
          "reason_code": "APPROVAL_REQUIRED",
          "risk_class": "MEDIUM",
          "pending_approval": true,
          "permit": "NONE"
        }
      }
    },
    {
      "note": "An escalated attempt cannot be dispatched.",
      "rpc": "Dispatch",
      "token": "execute-runner",
      "request": {
        "attempt_id": "{{attempt_id:pr}}"
      },
      "expect": {
        "error": {
          "code": "failed_precondition",
          "reason_code": ""
        }
      }
    },
    {
      "note": "Medium risk escalated by approval_required: no step-up.",
      "rpc": "Approve",
      "token": "approve-b",
      "request": {
        "attempt_id": "{{attempt_id:pr}}",
        "approval_digest": "{{approval_digest:pr}}",
        "reason": "ok"
      },
      "expect": {
        "attempt": {
          "state": "ADMITTED",
          "reason_code": "",
          "approver_principal_id": "human-b",
          "pending_approval": false,
          "permit": "ISSUED"
        },
        "existing": false
      }
    },
    {
      "rpc": "Dispatch",
      "token": "execute-runner",
      "request": {
        "attempt_id": "{{attempt_id:pr}}"
      },
      "expect": {
        "attempt": {
          "state": "OBSERVED",
          "reason_code": "",
          "outcome": "SUCCEEDED",
          "outcome_basis": "OBSERVED",
          "permit": "CONSUMED"
        },
        "adapter_calls": {
          "dispatch": 3,
          "observe": 3
        }
      }
    },
    {
      "rpc": "GetAttempt",
      "token": "read-a",
      "request": {
        "attempt_id": "{{attempt_id:pr}}"
      },
      "expect": {
        "attempt": {
          "state": "OBSERVED",
          "reason_code": "",
          "outcome": "SUCCEEDED",
          "same_attempt_as": "pr"
        }
      }
    }
  ]
}
