{
  "$comment": "quantum_posture: describes a connector-signed acknowledgement carrying a detached classical Ed25519 signature; this schema documents that signing shape and makes no hybrid or post-quantum claim.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helm.mindburn.org/schemas/connector_effect_acknowledgement_v2.json",
  "title": "Connector Effect Acknowledgement V2",
  "description": "Connector-signed source-system outcome bound to one exact HELM effect reservation, runtime activation, adapter capability release, and required finality contract.",
  "type": "object",
  "required": [
    "schema_version",
    "contract_version",
    "acknowledgement_id",
    "admission_id",
    "attempt_id",
    "tenant_id",
    "workspace_id",
    "audience",
    "connector_id",
    "connector_version",
    "connector_action",
    "connector_execution_ref",
    "adapter_id",
    "adapter_version",
    "adapter_capability_ref",
    "adapter_capability_hash",
    "intent_ref",
    "activation_record_ref",
    "activation_record_hash",
    "idempotency_key_hash",
    "effect_hash",
    "outcome",
    "response_hash",
    "finality",
    "issuer_id",
    "signing_key_ref",
    "algorithm",
    "observed_at",
    "acknowledgement_hash"
  ],
  "properties": {
    "schema_version": { "const": "connector-effect-acknowledgement.v2" },
    "contract_version": { "const": "2026-09-04" },
    "acknowledgement_id": { "$ref": "#/$defs/token" },
    "admission_id": { "$ref": "#/$defs/token" },
    "attempt_id": { "$ref": "#/$defs/token" },
    "tenant_id": { "$ref": "#/$defs/token" },
    "workspace_id": { "$ref": "#/$defs/token" },
    "audience": { "$ref": "#/$defs/token" },
    "connector_id": { "$ref": "#/$defs/token" },
    "connector_version": { "$ref": "#/$defs/token" },
    "connector_action": { "$ref": "#/$defs/token" },
    "connector_execution_ref": { "$ref": "#/$defs/token" },
    "adapter_id": { "$ref": "#/$defs/token" },
    "adapter_version": { "$ref": "#/$defs/token" },
    "adapter_capability_ref": { "$ref": "#/$defs/token" },
    "adapter_capability_hash": { "$ref": "#/$defs/sha256" },
    "proof_session_ref": { "$ref": "#/$defs/token" },
    "intent_ref": { "$ref": "#/$defs/token" },
    "activation_record_ref": { "$ref": "#/$defs/token" },
    "activation_record_hash": { "$ref": "#/$defs/sha256" },
    "idempotency_key_hash": { "$ref": "#/$defs/sha256" },
    "effect_hash": { "$ref": "#/$defs/sha256" },
    "outcome": { "enum": ["APPLIED", "NOT_APPLIED"] },
    "response_hash": { "$ref": "#/$defs/sha256" },
    "effect_ref": { "$ref": "#/$defs/token" },
    "reconciliation_ref": { "$ref": "#/$defs/token" },
    "finality": { "$ref": "#/$defs/finality" },
    "issuer_id": { "$ref": "#/$defs/token" },
    "signing_key_ref": { "$ref": "#/$defs/token" },
    "algorithm": { "const": "ed25519" },
    "observed_at": { "$ref": "#/$defs/timestamp" },
    "acknowledgement_hash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "APPLIED" } } },
      "then": { "required": ["effect_ref"] },
      "else": { "not": { "required": ["effect_ref"] } }
    },
    {
      "if": { "properties": { "finality": { "properties": { "resolution_state": { "const": "FINALIZED_SUCCESS" } } } } },
      "then": { "properties": { "outcome": { "const": "APPLIED" } } }
    },
    {
      "if": { "properties": { "finality": { "properties": { "resolution_state": { "const": "FINALIZED_FAILURE" } } } } },
      "then": { "properties": { "outcome": { "const": "NOT_APPLIED" } } }
    },
    {
      "if": { "properties": { "finality": { "properties": { "resolution_state": { "const": "COMPENSATED" } } } } },
      "then": { "properties": { "outcome": { "const": "APPLIED" } } }
    }
  ],
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^\\S+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "observed_external_fact": {
      "type": "object",
      "required": ["ref", "hash"],
      "properties": {
        "ref": { "$ref": "#/$defs/token" },
        "hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "finality": {
      "type": "object",
      "required": [
        "expected_finality_predicate_ref",
        "expected_finality_predicate_hash",
        "observed_external_facts",
        "reconciliation_deadline",
        "resolution_ref",
        "resolution_state"
      ],
      "properties": {
        "expected_finality_predicate_ref": { "$ref": "#/$defs/token" },
        "expected_finality_predicate_hash": { "$ref": "#/$defs/sha256" },
        "observed_external_facts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/observed_external_fact" }
        },
        "reconciliation_deadline": { "$ref": "#/$defs/timestamp" },
        "resolution_ref": { "$ref": "#/$defs/token" },
        "resolution_state": {
          "enum": ["FINALIZED_SUCCESS", "FINALIZED_FAILURE", "COMPENSATED"]
        },
        "conditional_compensation_ref": { "$ref": "#/$defs/token" }
      },
      "allOf": [
        {
          "if": { "properties": { "resolution_state": { "const": "COMPENSATED" } } },
          "then": { "required": ["conditional_compensation_ref"] },
          "else": { "not": { "required": ["conditional_compensation_ref"] } }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
