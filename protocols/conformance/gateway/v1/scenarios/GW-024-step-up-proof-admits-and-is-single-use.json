  "steps": [
    {
      "label": "merge",
      "rpc": "Propose",
      "token": "propose-a",
      "request": {
        "idempotency_key": "merge-1",
        "commitment_id": "commitment-1",
        "effect": {
          "effect_type": "github.pull_request.merge",
          "target": "github.com/Mindburn-Labs/example",
          "arguments_json": {
            "merge_method": "squash"
          }
        }
      },
      "expect": {
        "attempt": {
          "state": "ESCALATED",
          "reason_code": "APPROVAL_REQUIRED",
          "risk_class": "HIGH",
          "pending_approval": true
        }
      }
    },
    {
      "note": "A second attempt, for a proof bound to another attempt and for the replay below.",
      "label": "merge-2",
      "rpc": "Propose",
      "token": "propose-a",
      "request": {
        "idempotency_key": "merge-2",
        "commitment_id": "commitment-1",
