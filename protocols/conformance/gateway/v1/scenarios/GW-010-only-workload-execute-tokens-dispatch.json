{
  "schema": "helm.gateway.conformance.scenario.v1",
  "id": "GW-010",
  "title": "A human's token, a read token, a propose token or no token cannot dispatch",
  "rule": {
    "statement": "Dispatch and Observe take helm.gateway.execute, minted only for workload principals and checked against the gateway's own principal rows: a human's execute token and a workload's read or propose token are permission_denied INSUFFICIENT_PRIVILEGE, no token is unauthenticated, and the attempt is unchanged.",
    "cites": [
      {
        "doc": "docs/architecture/gateway-effect-api.md",
        "section": "Token scopes"
      },
      {
        "doc": "docs/architecture/gateway-effect-api.md",
        "section": "Dispatch and Observe (slice 3)"
      },
      {
        "doc": "protocols/proto/helm/gateway/v1/gateway.proto",
        "section": "helm.gateway.execute (workload principals only"
      }
    ]
  },
  "fixtures": {
    "tenants": [
      "tenant-a",
      "tenant-b"
    ],
    "principals": [
      {
        "id": "human-a",
        "kind": "human"
      },
      {
        "id": "human-b",
        "kind": "human"
      },
      {
        "id": "human-c",
        "kind": "human"
      },
      {
        "id": "agent-a",
        "kind": "agent"
      },
      {
        "id": "cp-runner",
        "kind": "service"
      }
    ],
    "configured_actor": "cp-runner",
    "effect_types": [
      {
        "effect_type": "github.repository.get",
        "risk": "low"
      },
      {
        "effect_type": "github.branch.create_from_changes",
        "risk": "medium"
      },
      {
        "effect_type": "github.pull_request.create_draft",
        "risk": "medium"
      }
    ],
    "mandates": [
      {
        "holder": "human-a",
        "effect_types": [
          "github.repository.get",
          "github.branch.create_from_changes",
          "github.pull_request.create_draft"
        ],
        "targets": [
          "github.com/Mindburn-Labs/example"
        ],
        "condition": "input.effect_type == \"github.repository.get\" || input.args.head.startsWith(\"helm/\")",
        "approval_required": [
          "github.pull_request.create_draft"
        ],
        "activation": {
          "requester": "agent-a",
          "approver": "human-c"
        }
      }
    ],
    "adapter": {
      "effect_types": [
        "github.repository.get",
        "github.branch.create_from_changes",
        "github.pull_request.create_draft"
      ],
      "dispatch": {
        "status": "SENT"
      },
      "observe": {
        "status": "SUCCEEDED"
      },
      "provider": {
        "default_branch": "main",
        "default_branch_sha": "0123456789abcdef0123456789abcdef01234567",
        "branch_commit_sha": "89abcdef0123456789abcdef0123456789abcdef"
      }
    }
  },
  "tokens": {
    "propose-a": {
      "scope": "helm.gateway.propose",
      "sub": "human-a",
      "act_sub": "cp-runner",
      "tenant": "tenant-a",
      "workspace": "ws-a",
      "jti": "propose-a"
    },
    "execute-runner": {
      "scope": "helm.gateway.execute",
      "sub": "cp-runner",
      "tenant": "tenant-a",
      "workspace": "ws-a",
      "jti": "execute-runner"
    },
    "read-a": {
      "scope": "helm.gateway.read",
      "sub": "human-a",
      "tenant": "tenant-a",
      "workspace": "ws-a",
      "jti": "read-a"
    },
    "execute-human": {
      "scope": "helm.gateway.execute",
      "sub": "human-b",
      "tenant": "tenant-a",
      "workspace": "ws-a",
      "jti": "execute-human"
    },
    "read-runner": {
      "scope": "helm.gateway.read",
      "sub": "cp-runner",
      "tenant": "tenant-a",
      "workspace": "ws-a",
      "jti": "read-runner"
    }
  },
  "steps": [
    {
      "label": "branch",
      "rpc": "Propose",
      "token": "propose-a",
      "request": {
        "idempotency_key": "branch-1",
        "commitment_id": "commitment-1",
        "effect": {
          "effect_type": "github.branch.create_from_changes",
          "target": "github.com/Mindburn-Labs/example",
          "arguments_json": {
            "schema": "helm.github.branch.create_from_changes.v1",
            "base": "main",
            "base_sha": "0123456789abcdef0123456789abcdef01234567",
            "head": "helm/skeleton",
            "message": "Add skeleton",
            "files": [
              {
                "path": "docs/skeleton.md",
                "mode": "100644",
                "content_utf8": "# Skeleton\n"
              }
            ]
          }
        }
      },
      "expect": {
        "attempt": {
          "state": "ADMITTED",
          "reason_code": "",
          "permit": "ISSUED"
        }
      }
    },
    {
      "rpc": "Dispatch",
      "token": "execute-human",
      "request": {
        "attempt_id": "{{attempt_id:branch}}"
      },
      "expect": {
        "error": {
          "code": "permission_denied",
          "reason_code": "INSUFFICIENT_PRIVILEGE"
        }
      }
    },
    {
      "rpc": "Observe",
      "token": "execute-human",
      "request": {
        "attempt_id": "{{attempt_id:branch}}"
      },
      "expect": {
        "error": {
          "code": "permission_denied",
          "reason_code": "INSUFFICIENT_PRIVILEGE"
        }
      }
    },
    {
      "rpc": "Dispatch",
      "token": "read-runner",
      "request": {
        "attempt_id": "{{attempt_id:branch}}"
      },
      "expect": {
        "error": {
          "code": "permission_denied",
          "reason_code": "INSUFFICIENT_PRIVILEGE"
        }
      }
    },
    {
      "note": "A worker's propose token never dispatches.",
      "rpc": "Dispatch",
      "token": "propose-a",
      "request": {
        "attempt_id": "{{attempt_id:branch}}"
      },
      "expect": {
        "error": {
          "code": "permission_denied",
          "reason_code": "INSUFFICIENT_PRIVILEGE"
        }
      }
    },
    {
      "rpc": "Dispatch",
      "request": {
        "attempt_id": "{{attempt_id:branch}}"
      },
      "expect": {
        "error": {
          "code": "unauthenticated",
          "reason_code": ""
        },
        "adapter_calls": {
          "dispatch": 0,
          "observe": 0
        }
      }
    },
    {
      "rpc": "GetAttempt",
      "token": "read-a",
      "request": {
        "attempt_id": "{{attempt_id:branch}}"
      },
      "expect": {
        "attempt": {
          "state": "ADMITTED",
          "reason_code": "",
          "permit": "ISSUED"
        }
      }
    }
  ]
}
