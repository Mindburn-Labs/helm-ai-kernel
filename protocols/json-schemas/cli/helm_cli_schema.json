{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://mindburn.org/schemas/helm-kernel-cli/v1",
    "title": "HELM AI Kernel Verification Output",
    "description": "JSON Schema for the output of `helm-ai-kernel verify --json` command. Exit code 0 = outcome VERIFIED, 1 = outcome FAILED or UNVERIFIABLE, 2 = no verdict (runtime or usage error). A check with status NOT_RUN had nothing to read and is never counted as passed. The fields outcome, check_counts and checks[].status are always present from verifier_version 0.3.0.",
    "type": "object",
    "required": [
        "bundle",
        "verified",
        "timestamp",
        "checks",
        "summary",
        "issue_count",
        "verifier_version"
    ],
    "properties": {
        "bundle": {
            "type": "string",
            "description": "Path to local evidence bundle verified."
        },
        "verified": {
            "type": "boolean",
            "description": "True exactly when outcome is VERIFIED: no check failed and every check the pack is required to give input to ran and held. It does not mean every listed check ran; see check_counts.not_run."
        },
        "outcome": {
            "type": "string",
            "enum": ["VERIFIED", "FAILED", "UNVERIFIABLE"],
            "description": "VERIFIED: every required check ran and held and none failed. FAILED: a check failed, evidence the pack is required to carry is missing, or no check ran. UNVERIFIABLE: the content is intact but no configured trust root vouches for the signer."
        },
        "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of the verification."
        },
        "roots": {
            "type": "object",
            "properties": {
                "manifest_root_hash": { "type": "string" },
                "merkle_root": { "type": "string" },
                "entry_count": { "type": "integer" }
            },
            "additionalProperties": false
        },
        "checks": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["name", "pass"],
                "properties": {
                    "name": { "type": "string" },
                    "pass": {
                        "type": "boolean",
                        "description": "True only when status is VERIFIED. False for FAILED, UNVERIFIABLE and NOT_RUN alike, so read status to tell a failure from a check that did not run."
                    },
                    "status": {
                        "type": "string",
                        "enum": ["VERIFIED", "FAILED", "UNVERIFIABLE", "NOT_RUN"],
                        "description": "VERIFIED: the check read its input and the property held. FAILED: it did not hold, or required input is missing. UNVERIFIABLE: intact, but no trust root vouches for the signer. NOT_RUN: the pack carries nothing for this check to read and nothing requires it."
                    },
                    "detail": {
                        "type": "string",
                        "description": "What a VERIFIED check established."
                    },
                    "reason": {
                        "type": "string",
                        "description": "Why the check failed, was unverifiable or did not run."
                    }
                },
                "additionalProperties": false
            }
        },
        "check_counts": {
            "type": "object",
            "description": "Checks counted by status. passed + failed + unverifiable + not_run equals the length of checks.",
            "required": ["passed", "failed", "unverifiable", "not_run"],
            "properties": {
                "passed": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 },
                "unverifiable": { "type": "integer", "minimum": 0 },
                "not_run": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
        },
        "summary": {
            "type": "string",
            "description": "Human-readable verdict with the passed, failed and not-run counts stated separately."
        },
        "issue_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of checks that ran and did not pass (FAILED or UNVERIFIABLE). Checks that did not run are not counted."
        },
        "verifier_version": {
            "type": "string"
        },
        "envelope_id": {
            "type": "string"
        },
        "sealed_at": {
            "type": "string"
        },
        "signature_valid_count": {
            "type": "integer"
        },
        "signature_total_count": {
            "type": "integer"
        },
        "anchor_index": {
            "type": ["integer", "null"]
        },
        "merkle_root": {
            "type": "string"
        },
        "seal": {
            "type": "object",
            "description": "Native EvidencePack seal verification result.",
            "required": ["state", "signature_valid", "anchor_status", "storage_status", "trust_level"],
            "properties": {
                "state": { "type": "string" },
                "signature_valid": { "type": "boolean" },
                "anchor_status": { "type": "string" },
                "storage_status": { "type": "string" },
                "trust_level": { "type": "string" },
                "pack_id": { "type": "string" },
                "index_hash": { "type": "string" },
                "merkle_root": { "type": "string" },
                "entry_count": { "type": "integer" },
                "signer_key_id": { "type": "string" },
                "signer_type": { "type": "string" },
                "anchor_receipts": { "type": "integer" },
                "storage_receipt": { "type": "string" },
                "signed_at": { "type": "string" },
                "errors": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
        },
        "trust_level": {
            "type": "string"
        },
        "seal_state": {
            "type": "string"
        },
        "seal_signature_valid": {
            "type": "boolean"
        },
        "anchor_status": {
            "type": "string"
        },
        "storage_status": {
            "type": "string"
        },
        "seal_subject_root": {
            "type": "string"
        },
        "seal_id": {
            "type": "string"
        }
    },
    "additionalProperties": false
}