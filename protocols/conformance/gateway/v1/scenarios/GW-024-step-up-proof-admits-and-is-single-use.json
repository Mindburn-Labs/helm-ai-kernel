      "step_up_token": "proof-merge-user-verification-unstated",
      "request": {
        "attempt_id": "{{attempt_id:merge}}",
        "approval_digest": "{{approval_digest:merge}}",
        "reason": "ok"
      },
      "expect": {
        "error": {
          "code": "permission_denied",
          "reason_code": "STEP_UP_REQUIRED"
        }
      }
    },
    {
      "note": "Every refusal left the attempt as it was.",
      "rpc": "GetAttempt",
      "token": "read-a",
      "request": {
        "attempt_id": "{{attempt_id:merge}}"
      },
      "expect": {
        "attempt": {
          "state": "ESCALATED",
          "reason_code": "APPROVAL_REQUIRED",
          "approver_principal_id": "",
          "pending_approval": true,
          "permit": "NONE"
        }
      }
    },
    {
      "note": "The same decide token, now with a proof bound to this attempt and digest: no refusal above used up either token.",
      "rpc": "Approve",
      "token": "approve-merge",
      "step_up_token": "proof-merge",
      "request": {
        "attempt_id": "{{attempt_id:merge}}",
        "approval_digest": "{{approval_digest:merge}}",
        "reason": "ok"
