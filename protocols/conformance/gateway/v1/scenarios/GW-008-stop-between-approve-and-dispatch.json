{
  "schema": "helm.gateway.conformance.scenario.v1",
  "id": "GW-008",
  "title": "A stop issued between approval and dispatch cancels at the dispatch claim",
  "rule": {
    "statement": "Stops take effect at admission and at the dispatch claim: a stop on the requester after the approval makes Dispatch a successful response whose attempt is CANCELLED with EMERGENCY_STOP_FENCED, the permit voided and the reservation released, and the adapter is never called. Admission after the stop is DENIED.",
    "cites": [
      {
        "doc": "docs/architecture/gateway-effect-api.md",
        "section": "Dispatch and Observe (slice 3)"
      },
      {
        "doc": "protocols/proto/helm/gateway/v1/gateway.proto",
        "section": "rpc Stop("
      },
      {
        "doc": "protocols/proto/helm/gateway/v1/gateway.proto",
        "section": "[reason_code: EMERGENCY_STOP_FENCED]"
      }
    ]
  },
  "fixtures": {
    "tenants": [
      "tenant-a",
      "tenant-b"
    ],
    "principals": [
      {
        "id": "human-a",
        "kind": "human"
      },
      {
        "id": "human-b",
        "kind": "human"
      },
      {
        "id": "human-c",
        "kind": "human"
      },
      {
        "id": "agent-a",
        "kind": "agent"
      },
      {
        "id": "cp-runner",
        "kind": "service"
      }
    ],
    "configured_actor": "cp-runner",
    "effect_types": [
      {
        "effect_type": "github.repository.get",
        "risk": "low"
      },
      {
        "effect_type": "github.branch.create_from_changes",
        "risk": "medium"
      },
      {
        "effect_type": "github.pull_request.create_draft",
        "risk": "medium"
      }
    ],
    "mandates": [
      {
        "holder": "human-a",
        "effect_types": [
          "github.repository.get",
          "github.branch.create_from_changes",
          "github.pull_request.create_draft"
        ],
        "targets": [
          "github.com/Mindburn-Labs/example"
        ],
        "condition": "input.effect_type == \"github.repository.get\" || input.args.head.startsWith(\"helm/\")",
        "approval_required": [
          "github.pull_request.create_draft"
        ],
        "activation": {
          "requester": "agent-a",
          "approver": "human-c"
        },
        "limits": [
          {
            "unit": "effects",
            "window": "day",
            "value": 5
          }
        ]
      }
    ],
    "adapter": {
      "effect_types": [
        "github.repository.get",
        "github.branch.create_from_changes",
        "github.pull_request.create_draft"
      ],
      "dispatch": {
        "status": "SENT"
      },
      "observe": {
        "status": "SUCCEEDED"
      },
      "provider": {
        "default_branch": "main",
        "default_branch_sha": "0123456789abcdef0123456789abcdef01234567",
        "branch_commit_sha": "89abcdef0123456789abcdef0123456789abcdef"
      }
    }
  },
  "tokens": {
    "propose-a": {
      "scope": "helm.gateway.propose",
      "sub": "human-a",
      "act_sub": "cp-runner",
      "tenant": "tenant-a",
      "workspace": "ws-a",
      "jti": "propose-a"
    },
    "execute-runner": {
      "scope": "helm.gateway.execute",
      "sub": "cp-runner",
      "tenant": "tenant-a",
      "workspace": "ws-a",
      "jti": "execute-runner"
    },
    "read-a": {
      "scope": "helm.gateway.read",
      "sub": "human-a",
      "tenant": "tenant-a",
      "workspace": "ws-a",
      "jti": "read-a"
    },
    "approve-b": {
      "scope": "helm.gateway.decide",
      "sub": "human-b",
      "act_sub": "cp-runner",
      "tenant": "tenant-a",
      "workspace": "ws-a",
      "jti": "decide-b",
      "authorization_details": [
        {
          "type": "helm_effect_decision",
          "attempt_id": "{{attempt_id:pr}}",
          "action": "approve"
        }
      ]
    }
  },
  "steps": [
    {
      "label": "branch",
      "rpc": "Propose",
      "token": "propose-a",
      "request": {
        "idempotency_key": "branch-1",
        "commitment_id": "commitment-1",
        "effect": {
          "effect_type": "github.branch.create_from_changes",
          "target": "github.com/Mindburn-Labs/example",
          "arguments_json": {
            "schema": "helm.github.branch.create_from_changes.v1",
            "base": "main",
            "base_sha": "0123456789abcdef0123456789abcdef01234567",
            "head": "helm/skeleton",
            "message": "Add skeleton",
            "files": [
              {
                "path": "docs/skeleton.md",
                "mode": "100644",
                "content_utf8": "# Skeleton\n"
              }
            ]
          }
        },
        "quote": [
          {
            "unit": "effects",
            "amount": 0
          }
        ]
      },
      "expect": {
        "attempt": {
          "state": "ADMITTED",
          "reason_code": ""
        }
      }
    },
    {
      "rpc": "Dispatch",
      "token": "execute-runner",
      "request": {
        "attempt_id": "{{attempt_id:branch}}"
      },
      "expect": {
        "attempt": {
          "state": "OBSERVED",
          "reason_code": "",
          "outcome": "SUCCEEDED"
        }
      }
    },
    {
      "label": "pr",
      "rpc": "Propose",
      "token": "propose-a",
      "request": {
        "idempotency_key": "pr-1",
        "commitment_id": "commitment-1",
        "effect": {
          "effect_type": "github.pull_request.create_draft",
          "target": "github.com/Mindburn-Labs/example",
          "arguments_json": {
            "schema": "helm.github.pull_request.create_draft.v1",
            "branch_attempt_id": "{{attempt_id:branch}}",
            "base": "main",
            "head": "helm/skeleton",
            "head_sha": "89abcdef0123456789abcdef0123456789abcdef",
            "title": "Skeleton",
            "body": ""
          }
        },
        "quote": [
          {
            "unit": "effects",
            "amount": 1
          }
        ]
      },
      "expect": {
        "attempt": {
          "state": "ESCALATED",
          "reason_code": "APPROVAL_REQUIRED"
        }
      }
    },
    {
      "rpc": "Approve",
      "token": "approve-b",
      "request": {
        "attempt_id": "{{attempt_id:pr}}",
        "approval_digest": "{{approval_digest:pr}}",
        "reason": "ok"
      },
      "expect": {
        "attempt": {
          "state": "ADMITTED",
          "reason_code": "",
          "permit": "ISSUED",
          "exposure": "HELD"
        }
      }
    },
    {
      "note": "An operator stops the requester.",
      "control": {
        "kind": "stop",
        "tenant": "tenant-a",
        "scope_kind": "principal",
        "scope_key": "human-a",
        "issued_by": "human-c"
      }
    },
    {
      "rpc": "Dispatch",
      "token": "execute-runner",
      "request": {
        "attempt_id": "{{attempt_id:pr}}"
      },
      "expect": {
        "attempt": {
          "state": "CANCELLED",
          "reason_code": "EMERGENCY_STOP_FENCED",
          "permit": "VOIDED",
          "exposure": "RELEASED"
        },
        "existing": false,
        "adapter_calls": {
          "dispatch": 1,
          "observe": 1
        }
      }
    },
    {
      "rpc": "Dispatch",
      "token": "execute-runner",
      "request": {
        "attempt_id": "{{attempt_id:pr}}"
      },
      "expect": {
        "attempt": {
          "state": "CANCELLED",
          "reason_code": "EMERGENCY_STOP_FENCED"
        },
        "existing": true,
        "adapter_calls": {
          "dispatch": 1,
          "observe": 1
        }
      }
    },
    {
      "rpc": "Propose",
      "token": "propose-a",
      "request": {
        "idempotency_key": "branch-2",
        "commitment_id": "commitment-1",
        "effect": {
          "effect_type": "github.branch.create_from_changes",
          "target": "github.com/Mindburn-Labs/example",
          "arguments_json": {
            "schema": "helm.github.branch.create_from_changes.v1",
            "base": "main",
            "base_sha": "0123456789abcdef0123456789abcdef01234567",
            "head": "helm/after-stop",
            "message": "Add skeleton",
            "files": [
              {
                "path": "docs/skeleton.md",
                "mode": "100644",
                "content_utf8": "# Skeleton\n"
              }
            ]
          }
        },
        "quote": [
          {
            "unit": "effects",
            "amount": 0
          }
        ]
      },
      "expect": {
        "attempt": {
          "state": "DENIED",
          "reason_code": "EMERGENCY_STOP_FENCED"
        }
      }
    }
  ]
}
